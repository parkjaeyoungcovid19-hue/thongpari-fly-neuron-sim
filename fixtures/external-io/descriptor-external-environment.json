{
  "type": "module_descriptor",
  "api_version": "external_io.v1",
  "module_id": "fixture.loopback",
  "version": "1.0.0",
  "display_name": "Loopback environment (test fixture)",
  "attach_mode": "external_environment",
  "clock_mode": "lockstep",
  "restore_support": "none",
  "capabilities": ["observation_frames", "action_frames", "continuous_actions", "discrete_actions", "lockstep_clock"],
  "required_capabilities": ["observation_frames", "action_frames"],
  "observations": [
    {"channel_id": "ramp", "kind": "continuous", "unit": "normalized", "axis": "none", "min": 0, "max": 1, "length": 1, "rate_hz": 30, "optional": false},
    {"channel_id": "heading", "kind": "continuous", "unit": "deg", "axis": "yaw", "min": -180, "max": 180, "length": 1, "rate_hz": 30, "optional": true}
  ],
  "actions": [
    {"channel_id": "move", "kind": "continuous", "unit": "normalized", "axis": "forward", "min": -1, "max": 1, "length": 2, "rate_hz": 30},
    {"channel_id": "mode_switch", "kind": "discrete", "unit": "none", "axis": "none", "choices": ["idle", "go", "stop"], "rate_hz": 10}
  ],
  "budgets": {"max_frame_bytes": 65536, "max_frame_width": 64, "max_frame_height": 64, "max_queue_depth": 8}
}
