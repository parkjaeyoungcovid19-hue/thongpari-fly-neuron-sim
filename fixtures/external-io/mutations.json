{
  "note": "Each case copies `base`, applies `ops` ({path, set | remove | float}), then decodes; the decoder must reject with `code`. float: nan | inf. Frame cases are decoded against the descriptor named by their module id.",
  "cases": [
    {"name": "wrong-api-version", "base": "descriptor-external-environment.json", "ops": [{"path": "api_version", "set": "external_io.v2"}], "code": "unsupported_api_version"},
    {"name": "missing-api-version", "base": "descriptor-external-environment.json", "ops": [{"path": "api_version", "remove": true}], "code": "missing_field"},
    {"name": "missing-budgets", "base": "descriptor-external-environment.json", "ops": [{"path": "budgets", "remove": true}], "code": "missing_field"},
    {"name": "bad-unit", "base": "descriptor-external-environment.json", "ops": [{"path": "actions.0.unit", "set": "furlongs"}], "code": "unknown_unit"},
    {"name": "bad-axis", "base": "descriptor-external-environment.json", "ops": [{"path": "observations.1.axis", "set": "sideways"}], "code": "unknown_axis"},
    {"name": "missing-capability", "base": "descriptor-external-environment.json", "ops": [{"path": "capabilities", "set": ["observation_frames", "continuous_actions", "discrete_actions", "lockstep_clock"]}], "code": "missing_capability"},
    {"name": "unknown-required-capability", "base": "descriptor-external-environment.json", "ops": [{"path": "required_capabilities", "set": ["observation_frames", "teleport"]}], "code": "unknown_capability"},
    {"name": "nan-bound", "base": "descriptor-external-environment.json", "ops": [{"path": "actions.0.max", "float": "nan"}], "code": "not_finite"},
    {"name": "oversize-frame-dims", "base": "descriptor-auxiliary.json", "ops": [{"path": "budgets.max_frame_width", "set": 100000}], "code": "oversize_frame"},
    {"name": "oversize-frame-bytes", "base": "descriptor-auxiliary.json", "ops": [{"path": "budgets.max_frame_bytes", "set": 1073741824}], "code": "oversize_frame"},
    {"name": "auxiliary-declares-actions", "base": "descriptor-external-environment.json", "ops": [{"path": "attach_mode", "set": "auxiliary"}], "code": "mode_violation"},
    {"name": "duplicate-channel", "base": "descriptor-external-environment.json", "ops": [{"path": "actions.1.channel_id", "set": "move"}], "code": "duplicate_id"},
    {"name": "observation-out-of-range", "base": "observation-loopback.json", "ops": [{"path": "channels.0.values.0", "set": 1.5}], "code": "out_of_range"},
    {"name": "observation-wrong-length", "base": "observation-loopback.json", "ops": [{"path": "channels.0.values", "set": [0.1, 0.2]}], "code": "wrong_length"},
    {"name": "observation-nan", "base": "observation-loopback.json", "ops": [{"path": "channels.0.values.0", "float": "nan"}], "code": "not_finite"},
    {"name": "observation-inf", "base": "observation-loopback.json", "ops": [{"path": "channels.0.values.0", "float": "inf"}], "code": "not_finite"},
    {"name": "observation-missing-required-channel", "base": "observation-loopback.json", "ops": [{"path": "channels", "set": []}], "code": "missing_field"},
    {"name": "observation-missing-seq", "base": "observation-loopback.json", "ops": [{"path": "seq", "remove": true}], "code": "missing_field"},
    {"name": "observation-wrong-unit", "base": "observation-loopback.json", "ops": [{"path": "channels.0.unit", "set": "deg"}], "code": "unknown_unit"},
    {"name": "observation-lockstep-wall-timebase", "base": "observation-loopback.json", "ops": [{"path": "timebase", "set": "wall_clock"}], "code": "mode_violation"},
    {"name": "observation-unknown-channel", "base": "observation-loopback.json", "ops": [{"path": "channels.0.channel_id", "set": "mystery"}], "code": "unknown_channel"},
    {"name": "observation-expired-before-source", "base": "observation-loopback.json", "ops": [{"path": "valid_until", "set": 10}], "code": "out_of_range"},
    {"name": "frame-oversize-dims", "base": "observation-sensor.json", "ops": [{"path": "frame.width", "set": 64}, {"path": "frame.height", "set": 64}, {"path": "frame.byte_length", "set": 4096}], "code": "oversize_frame"},
    {"name": "frame-wrong-byte-length", "base": "observation-sensor.json", "ops": [{"path": "frame.byte_length", "set": 255}], "code": "wrong_length"},
    {"name": "frame-undeclared-format", "base": "observation-sensor.json", "ops": [{"path": "frame.format", "set": "rgba8"}], "code": "invalid_value"},
    {"name": "action-out-of-range", "base": "action-loopback.json", "ops": [{"path": "actions.0.values.1", "set": 2}], "code": "out_of_range"},
    {"name": "action-wrong-length", "base": "action-loopback.json", "ops": [{"path": "actions.0.values", "set": [0.5]}], "code": "wrong_length"},
    {"name": "action-nan", "base": "action-loopback.json", "ops": [{"path": "actions.0.values.0", "float": "nan"}], "code": "not_finite"},
    {"name": "action-bad-choice", "base": "action-loopback.json", "ops": [{"path": "actions.1.choice", "set": "fire"}], "code": "out_of_range"},
    {"name": "action-missing-action-id", "base": "action-loopback.json", "ops": [{"path": "action_id", "remove": true}], "code": "missing_field"},
    {"name": "action-missing-expiry", "base": "action-loopback.json", "ops": [{"path": "expires_tick", "remove": true}], "code": "missing_field"},
    {"name": "action-expiry-before-tick", "base": "action-loopback.json", "ops": [{"path": "expires_tick", "set": 5}], "code": "out_of_range"},
    {"name": "action-unknown-channel", "base": "action-loopback.json", "ops": [{"path": "actions.0.channel_id", "set": "fire"}], "code": "unknown_channel"},
    {"name": "action-empty", "base": "action-loopback.json", "ops": [{"path": "actions", "set": []}], "code": "wrong_length"},
    {"name": "action-wrong-version", "base": "action-loopback.json", "ops": [{"path": "api_version", "set": "external_io.v0"}], "code": "unsupported_api_version"},
    {"name": "action-wrong-target", "base": "action-loopback.json", "ops": [{"path": "target_endpoint", "set": "fixture.other"}], "code": "invalid_value"}
  ]
}
